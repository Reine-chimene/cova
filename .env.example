# Backend — développement local (Docker MySQL) ou production (Aiven / Cloud Run)
# Ne commitez jamais de fichier .env contenant des secrets.

# Base de données
DB_HOST=
DB_PORT=
DB_NAME=defaultdb
DB_USER=avnadmin
DB_SSL_MODE=REQUIRED

# Définir DB_PASSWORD dans l'environnement ou Cloud Run Secret Manager (ne pas versionner)
DB_PASSWORD=

# JWT (production : valeur longue aléatoire, ≥ 32 caractères)
JWT_SECRET=

# Origines autorisées (séparées par des virgules)
# Exemple : https://votre-projet.vercel.app,http://localhost:3020
CORS_ALLOWED_ORIGINS=

# Cloud Run
PORT=8080
